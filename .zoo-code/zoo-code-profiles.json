{
  "electrohireZooCode": {
    "schemaVersion": 1,
    "projectId": "electrohire-defaults",
    "outputFile": "electrohire-zoo-code.local.json",
    "allowBuiltInModeMappings": true,
    "allowedProviders": ["openrouter", "openai"],
    "credentialBindings": [
      {
        "provider": "openrouter",
        "environment": "OPENROUTER_API_KEY",
        "field": "openRouterApiKey",
        "required": true
      },
      {
        "provider": "openai",
        "environment": "NOERELAY_API_KEY",
        "field": "openAiApiKey",
        "required": false
      }
    ]
  },
  "providerProfiles": {
    "currentApiConfigName": "Orchestrator",
    "apiConfigs": {
      "Fast": {
        "id": "electrohire-or-fast-v3",
        "apiProvider": "openrouter",
        "openRouterModelId": "deepseek/deepseek-v4-flash",
        "enableReasoningEffort": true,
        "reasoningEffort": "high",
        "modelMaxTokens": 16384,
        "modelMaxThinkingTokens": 4096,
        "modelTemperature": 0.2,
        "todoListEnabled": false,
        "consecutiveMistakeLimit": 3
      },
      "Code": {
        "id": "electrohire-or-code-v3",
        "apiProvider": "openrouter",
        "openRouterModelId": "deepseek/deepseek-v4-pro",
        "enableReasoningEffort": true,
        "reasoningEffort": "high",
        "modelMaxTokens": 32768,
        "modelMaxThinkingTokens": 8192,
        "modelTemperature": 0.1,
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      },
      "Orchestrator": {
        "id": "electrohire-or-orchestrator-v3",
        "apiProvider": "openrouter",
        "openRouterModelId": "z-ai/glm-5.2",
        "enableReasoningEffort": true,
        "reasoningEffort": "high",
        "modelMaxTokens": 32768,
        "modelMaxThinkingTokens": 8192,
        "modelTemperature": 0.15,
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      },
      "Architecture": {
        "id": "electrohire-or-architecture-v3",
        "apiProvider": "openrouter",
        "openRouterModelId": "moonshotai/kimi-k3",
        "enableReasoningEffort": true,
        "reasoningEffort": "high",
        "modelMaxTokens": 32768,
        "modelMaxThinkingTokens": 8192,
        "modelTemperature": 0.15,
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      },
      "Review": {
        "id": "electrohire-or-review-v3",
        "apiProvider": "openrouter",
        "openRouterModelId": "qwen/qwen3.8-max",
        "enableReasoningEffort": true,
        "reasoningEffort": "medium",
        "modelMaxTokens": 65536,
        "modelMaxThinkingTokens": 8192,
        "modelTemperature": 0.1,
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      },
      "Release": {
        "id": "electrohire-or-release-v3",
        "apiProvider": "openrouter",
        "openRouterModelId": "openai/gpt-5.6-sol",
        "enableReasoningEffort": true,
        "reasoningEffort": "medium",
        "modelMaxTokens": 65536,
        "modelMaxThinkingTokens": 8192,
        "modelTemperature": 0.1,
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      },
      "Security": {
        "id": "electrohire-or-security-v3",
        "apiProvider": "openrouter",
        "openRouterModelId": "openai/gpt-5.6-sol",
        "enableReasoningEffort": true,
        "reasoningEffort": "high",
        "modelMaxTokens": 65536,
        "modelMaxThinkingTokens": 16384,
        "modelTemperature": 0.1,
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      },
      "NoeRelay": {
        "id": "noerelay-local",
        "apiProvider": "openai",
        "openAiBaseUrl": "http://127.0.0.1:8080/v1",
        "openAiModelId": "noerelay/epr-1",
        "modelMaxTokens": 4096,
        "modelTemperature": 0.7,
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      },
      "NoeRelayTest": {
        "id": "noerelay-test",
        "apiProvider": "openai",
        "openAiBaseUrl": "http://127.0.0.1:8080/v1",
        "openAiModelId": "noerelay/epr-1",
        "modelMaxTokens": 8192,
        "modelTemperature": 0.3,
        "system_prompt": "You are a NoeRelay test subagent. Your job is to test the NoeRelay gateway by sending requests and verifying responses. Available endpoints: http://127.0.0.1:8080/v1/chat/completions, http://127.0.0.1:8080/health, http://127.0.0.1:8080/metrics, http://127.0.0.1:8080/dashboard. You can run benchmarks with: python scripts/run_benchmark.py --inline --cohort test --gateway-url http://127.0.0.1:8080. You can run tests with: python -m pytest tests/ -v.",
        "todoListEnabled": true,
        "consecutiveMistakeLimit": 3
      }
    },
    "modeApiConfigs": {
      "ask": "noerelay-local",
      "architect": "noerelay-local",
      "code": "noerelay-local",
      "debug": "noerelay-local",
      "orchestrator": "noerelay-local",
      "reviewer": "electrohire-or-review-v3",
      "long-horizon": "electrohire-or-review-v3",
      "benchmark": "electrohire-or-orchestrator-v3",
      "release": "electrohire-or-release-v3",
      "security": "electrohire-or-security-v3",
      "test": "noerelay-test"
    }
  },
  "globalSettings": {
    "mode": "orchestrator",
    "autoApprovalEnabled": true,
    "alwaysAllowReadOnly": true,
    "alwaysAllowReadOnlyOutsideWorkspace": false,
    "alwaysAllowWrite": false,
    "alwaysAllowWriteOutsideWorkspace": false,
    "alwaysAllowWriteProtected": false,
    "alwaysAllowMcp": false,
    "alwaysAllowModeSwitch": false,
    "alwaysAllowSubtasks": false,
    "alwaysAllowExecute": false,
    "destructiveCommandGuardEnabled": false,
    "alwaysAllowFollowupQuestions": false,
    "allowedMaxRequests": 40,
    "allowedMaxCost": 2.0,
    "preventCompletionWithOpenTodos": true,
    "autoCondenseContext": true,
    "autoCondenseContextPercent": 75,
    "includeCurrentTime": true,
    "includeCurrentCost": true,
    "enableCheckpoints": true,
    "telemetrySetting": "disabled",
    "mcpEnabled": true
  }
}
