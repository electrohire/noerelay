{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electrohire.example/epr/schemas/task-contract.schema.json",
  "title": "EPR Task Contract",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "goal",
    "task_kind",
    "risk_class",
    "required_capabilities",
    "acceptance_criteria",
    "governance"
  ],
  "properties": {
    "version": {"const": "1.0"},
    "task_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "project_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 10000},
    "task_kind": {
      "enum": [
        "conversation",
        "factual_research",
        "requirements",
        "architecture",
        "coding",
        "verification",
        "image_understanding",
        "image_generation",
        "computer_use",
        "other"
      ]
    },
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "input_modalities": {
      "type": "array",
      "items": {"enum": ["text", "image", "audio", "video", "file"]},
      "uniqueItems": true,
      "default": ["text"]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "text",
          "vision",
          "audio_input",
          "video_input",
          "tool_calling",
          "structured_output",
          "code_execution",
          "image_generation",
          "image_editing",
          "retrieval",
          "formal_verification",
          "human_review"
        ]
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "kind", "mandatory"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "description": {"type": "string", "minLength": 1},
          "kind": {"enum": ["executable", "observable", "judgmental", "missing"]},
          "mandatory": {"type": "boolean"},
          "evaluator_ref": {"type": "string"},
          "requirement_refs": {
            "type": "array",
            "items": {"$ref": "common.schema.json#/$defs/identifier"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": ["data_policy", "max_cost_usd", "max_latency_ms"],
      "properties": {
        "data_policy": {"enum": ["standard", "no_training", "zdr", "local_only"]},
        "allowed_provider_families": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "denied_provider_families": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
        "max_latency_ms": {"type": "integer", "exclusiveMinimum": 0},
        "required_acceptance_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "human_approval_required": {"type": "boolean", "default": false},
        "retention_class": {"enum": ["ephemeral", "project", "regulated"]}
      },
      "additionalProperties": false
    },
    "trace_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "target_id"],
        "properties": {
          "relation": {
            "enum": ["decomposes", "satisfies", "implements", "verifies", "depends_on", "supersedes"]
          },
          "target_id": {"$ref": "common.schema.json#/$defs/identifier"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
