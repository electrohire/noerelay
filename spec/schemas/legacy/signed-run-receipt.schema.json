{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noerelay.local/schemas/signed-run-receipt.schema.json",
  "title": "NoeRelay signed run receipt",
  "type": "object",
  "required": ["receipt", "algorithm", "signing_key_id", "public_key_base64", "signature_base64"],
  "properties": {
    "receipt": {
      "type": "object",
      "required": [
        "receipt_version", "run_id", "organization_id", "project_id", "user_id",
        "contract_hash", "selected_candidate_id", "output_sha256", "actual_cost_microusd",
        "cost_source", "input_tokens", "output_tokens", "release_outcome", "ledger_head",
        "receipt_hash"
      ],
      "properties": {
        "receipt_version": {"const": "1.0.0"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "organization_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_candidate_id": {"type": "string", "minLength": 1},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actual_cost_microusd": {"type": "integer", "minimum": 0},
        "cost_source": {"enum": ["estimated", "provider_reported", "billed"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "release_outcome": {"const": "accepted"},
        "ledger_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "algorithm": {"const": "Ed25519"},
    "signing_key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "public_key_base64": {"type": "string", "minLength": 43, "maxLength": 44},
    "signature_base64": {"type": "string", "minLength": 86, "maxLength": 88}
  },
  "additionalProperties": false
}
