{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electrohire.example/epr/schemas/ledger-event.schema.json",
  "title": "EPR Hash-Linked Ledger Event",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "timestamp",
    "actor",
    "event_type",
    "subject_id",
    "payload",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "event_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "run_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "actor": {"$ref": "common.schema.json#/$defs/actor"},
    "event_type": {
      "enum": [
        "request_received",
        "contract_proposed",
        "contract_validated",
        "policy_checked",
        "context_compiled",
        "route_selected",
        "action_started",
        "action_completed",
        "evidence_recorded",
        "claim_transitioned",
        "verification_completed",
        "compaction_completed",
        "fallback_triggered",
        "human_review_requested",
        "outcome_accepted",
        "outcome_rejected"
      ]
    },
    "subject_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "payload": {"type": "object"},
    "previous_event_hash": {
      "oneOf": [
        {"const": "GENESIS"},
        {"$ref": "common.schema.json#/$defs/sha256"}
      ]
    },
    "event_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "additionalProperties": false
}
