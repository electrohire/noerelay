{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim",
  "type": "object",
  "required": [
    "claim_id",
    "kind",
    "refuting_evidence",
    "state",
    "statement",
    "supporting_evidence"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/ClaimKind"
    },
    "refuting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "$ref": "#/definitions/EpistemicState"
    },
    "statement": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ClaimKind": {
      "type": "string",
      "enum": [
        "fact",
        "requirement",
        "decision",
        "assumption",
        "observation",
        "prediction",
        "preference",
        "artifact"
      ]
    },
    "EpistemicState": {
      "type": "string",
      "enum": [
        "neither",
        "supported",
        "refuted",
        "both"
      ]
    }
  }
}