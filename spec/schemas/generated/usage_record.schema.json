{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UsageRecord",
  "type": "object",
  "required": [
    "cost",
    "dimensions",
    "input_tokens",
    "output_tokens"
  ],
  "properties": {
    "cost": {
      "$ref": "#/definitions/CostBreakdown"
    },
    "dimensions": {
      "$ref": "#/definitions/UsageDimensions"
    },
    "input_tokens": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "output_tokens": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CostBreakdown": {
      "type": "object",
      "required": [
        "expected_fallback_microusd",
        "expected_human_review_microusd",
        "expected_retry_microusd",
        "inference_microusd",
        "infrastructure_microusd",
        "tools_microusd",
        "verification_microusd"
      ],
      "properties": {
        "expected_fallback_microusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "expected_human_review_microusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "expected_retry_microusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "inference_microusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "infrastructure_microusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tools_microusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verification_microusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "UsageDimensions": {
      "type": "object",
      "required": [
        "api_key_id",
        "environment_id",
        "model_id",
        "organization_id",
        "project_id",
        "user_id"
      ],
      "properties": {
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_key_id": {
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "organization_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "tool_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}