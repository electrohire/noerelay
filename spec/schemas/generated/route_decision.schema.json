{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteDecision",
  "type": "object",
  "required": [
    "rejections"
  ],
  "properties": {
    "expected_total_cost_microusd": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "rejections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CandidateRejection"
      }
    },
    "selected_candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_openrouter_model_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CandidateRejection": {
      "type": "object",
      "required": [
        "candidate_id",
        "reasons"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RejectionReason"
          }
        }
      },
      "additionalProperties": false
    },
    "RejectionReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unavailable",
            "data_policy",
            "provider_denied",
            "invalid_model_identity",
            "cost_cap",
            "latency_cap",
            "acceptance_threshold",
            "independent_verification",
            "arithmetic_overflow"
          ]
        },
        {
          "type": "object",
          "required": [
            "missing_capability"
          ],
          "properties": {
            "missing_capability": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}