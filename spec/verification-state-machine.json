{
  "machine_id": "epr-verification-lifecycle",
  "version": "1.0.0",
  "initial_state": "received",
  "terminal_states": ["completed", "rejected"],
  "states": [
    "received",
    "contract_proposed",
    "clarification_required",
    "contract_validated",
    "policy_checked",
    "context_compiled",
    "routed",
    "executing",
    "evidence_normalized",
    "verifying",
    "repairable_failure",
    "escalation_required",
    "human_review",
    "accepted",
    "completed",
    "rejected"
  ],
  "transitions": [
    {"from": "received", "event": "propose_contract", "to": "contract_proposed", "guard": "request_schema_valid"},
    {"from": "contract_proposed", "event": "request_clarification", "to": "clarification_required", "guard": "mandatory_acceptance_missing_or_ambiguous"},
    {"from": "clarification_required", "event": "receive_clarification", "to": "contract_proposed", "guard": "clarification_addresses_gap"},
    {"from": "contract_proposed", "event": "validate_contract", "to": "contract_validated", "guard": "contract_schema_valid_and_acceptance_sufficient"},
    {"from": "contract_validated", "event": "check_policy", "to": "policy_checked", "guard": "policy_allows_progress"},
    {"from": "contract_validated", "event": "deny_policy", "to": "rejected", "guard": "non_authorizable_policy_violation"},
    {"from": "policy_checked", "event": "compile_context", "to": "context_compiled", "guard": "compaction_invariants_hold"},
    {"from": "context_compiled", "event": "select_route", "to": "routed", "guard": "admissible_route_exists"},
    {"from": "context_compiled", "event": "no_admissible_route", "to": "escalation_required", "guard": "router_failed_closed"},
    {"from": "routed", "event": "start_action", "to": "executing", "guard": "budget_and_permissions_reserved"},
    {"from": "executing", "event": "record_result", "to": "evidence_normalized", "guard": "result_bound_to_actor_activity_and_hash"},
    {"from": "evidence_normalized", "event": "start_verification", "to": "verifying", "guard": "required_verification_dag_materialized"},
    {"from": "verifying", "event": "verification_passed", "to": "accepted", "guard": "all_mandatory_criteria_pass_and_no_blocking_conflict"},
    {"from": "verifying", "event": "verification_failed_repairable", "to": "repairable_failure", "guard": "repair_budget_available"},
    {"from": "verifying", "event": "verification_failed_unresolved", "to": "escalation_required", "guard": "no_admissible_repair"},
    {"from": "repairable_failure", "event": "select_semantic_fallback", "to": "routed", "guard": "fallback_route_admissible"},
    {"from": "repairable_failure", "event": "repair_exhausted", "to": "escalation_required", "guard": "no_fallback_or_budget_exhausted"},
    {"from": "escalation_required", "event": "request_human_review", "to": "human_review", "guard": "human_authority_available"},
    {"from": "escalation_required", "event": "reject", "to": "rejected", "guard": "no_authorized_escalation"},
    {"from": "human_review", "event": "approve", "to": "accepted", "guard": "approval_scope_covers_outcome"},
    {"from": "human_review", "event": "reject", "to": "rejected", "guard": "true"},
    {"from": "accepted", "event": "issue_receipt", "to": "completed", "guard": "receipt_contains_ledger_head_and_verification_evidence"}
  ],
  "global_invariants": [
    "every_transition_is_ledgered",
    "no_accepted_state_with_failed_mandatory_criterion",
    "no_accepted_high_risk_state_with_blocking_conflicted_claim",
    "no_execution_before_policy_check",
    "no_high_risk_self_verification",
    "no_compaction_without_recoverable_evidence_handles",
    "no_terminal_acceptance_without_evidence_receipt"
  ]
}
