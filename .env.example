# Secrets: leave blank here. Use Windows User variables locally and GitHub's
# protected `Test` environment for CI.
OPENROUTER_API_KEY=
HF_TOKEN=
NOERELAY_AUTH_API_KEYS=
NOERELAY_MASTER_KEY=

# Rust authority gateway. NOERELAY_API_KEY must contain at least 32 characters.
NOERELAY_API_KEY=
NOERELAY_ORGANIZATION_ID=local-org
NOERELAY_PROJECT_ID=local-project
NOERELAY_ENVIRONMENT_ID=development
NOERELAY_BIND=127.0.0.1:8080
# JSON array of versioned routing candidates; see docs/requirements.md NR-ROUTE-001.
NOERELAY_CANDIDATES_JSON=
NOERELAY_BUDGET_LIMIT_MICROUSD=10000000000
NOERELAY_CONTEXT_BUDGET_TOKENS=32768
DATABASE_URL=postgresql://noerelay:replace-me@127.0.0.1:5432/noerelay
# Ed25519 seed: exactly 32 bytes encoded as 64 hexadecimal characters.
NOERELAY_RECEIPT_SIGNING_SEED_HEX=
NOERELAY_RECEIPT_SIGNING_KEY_ID=
NOERELAY_POSTGRES_PASSWORD=

# Optional Go A2A protocol adapter. This key authenticates incoming A2A callers;
# it must differ from the adapter's NOERELAY_API_KEY service credential.
NOERELAY_A2A_BEARER_KEY=
NOERELAY_A2A_LISTEN=127.0.0.1:8090
NOERELAY_A2A_EXTERNAL_BASE_URL=http://127.0.0.1:8090
NOERELAY_A2A_PRINCIPAL_ID=a2a-adapter
NOERELAY_INTERNAL_URL=http://127.0.0.1:8080

# Non-secret runtime configuration.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/electrohire/noerelay
OPENROUTER_APP_TITLE=NoeRelay
NOERELAY_LIVE_TESTS=0
HF_HOME=.cache/huggingface

# Gateway configuration (non-secret; defaults shown).
NOERELAY_GATEWAY_HOST=127.0.0.1
NOERELAY_GATEWAY_PORT=8080
NOERELAY_OPENROUTER_MODE=stub
NOERELAY_POLICY_PATH=spec/routing-policy.json
NOERELAY_STATE_MACHINE_PATH=spec/verification-state-machine.json
NOERELAY_PORTFOLIO_PATH=examples/candidate-actions.json
NOERELAY_DEFAULT_MAX_COST_USD=0.25
NOERELAY_DEFAULT_MAX_LATENCY_MS=60000
NOERELAY_EXTERNAL_BASE_URL=http://127.0.0.1:8080

# HTTP security and resource limits. Authentication becomes required
# automatically on non-loopback binds. Set NOERELAY_AUTH_REQUIRED=1 to require
# it on loopback as well; do not set it to 0 on an exposed deployment.
NOERELAY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NOERELAY_MAX_REQUEST_BODY_BYTES=4194304
NOERELAY_RATE_LIMIT_RATE=10.0
NOERELAY_RATE_LIMIT_BURST=20
NOERELAY_RUN_RETENTION_MAX=10000
NOERELAY_REQUEST_TIMEOUT_SECONDS=30
NOERELAY_MAX_CONCURRENT_REQUESTS=100
NOERELAY_PRODUCTION_MODE=0

# Persistence, logging, and endpoints.
NOERELAY_DATABASE_ENABLED=1
NOERELAY_DATABASE_PATH=.noerelay/noerelay.db
NOERELAY_PERSISTENCE_DIR=
NOERELAY_LOG_LEVEL=INFO
NOERELAY_LOG_OUTPUT=stdout
NOERELAY_LOG_FILE_PATH=.noerelay/noerelay.log
NOERELAY_ENABLE_HEALTH_ENDPOINT=1
NOERELAY_ENABLE_METRICS_ENDPOINT=1
NOERELAY_CACHE_ENABLED=0
NOERELAY_CACHE_MAX_SIZE=100
NOERELAY_CACHE_TTL_SECONDS=3600

# Local-model and escalation policy.
NOERELAY_LOCAL_MODEL_ENABLED=1
NOERELAY_LOCAL_MODEL_URL=http://127.0.0.1:11434
NOERELAY_ESCALATION_HIR_THRESHOLD=0.15
NOERELAY_ESCALATION_RR_THRESHOLD=0.25

# TLS (normally terminated by a reverse proxy or ingress).
NOERELAY_TLS_ENABLED=0
NOERELAY_TRUSTED_PROXY_TLS=0
NOERELAY_TLS_CERT_PATH=
NOERELAY_TLS_KEY_PATH=

# RTK compression.
NOERELAY_COMPRESSION_ENABLED=0
NOERELAY_COMPRESSION_STRATEGY=dedup
NOERELAY_COMPRESSION_MIN_TOKENS=512
NOERELAY_COMPRESSION_TARGET_RATIO=0.5
NOERELAY_COMPRESSION_SUMMARIZER_MODEL=noerelay/epr-1
NOERELAY_COMPRESSION_SUMMARIZER_MAX_MESSAGES=10
NOERELAY_COMPRESSION_QUALITY_THRESHOLD=0.0
NOERELAY_COMPRESSION_CACHE_ENABLED=1
NOERELAY_COMPRESSION_CACHE_MAX_SIZE=100
NOERELAY_COMPRESSION_CACHE_TTL=300
NOERELAY_COMPRESSION_PROFILING_ENABLED=1
NOERELAY_COMPRESSION_ADAPTIVE_RATIO=0
NOERELAY_COMPRESSION_ADAPTIVE_MIN_RATIO=0.3
NOERELAY_COMPRESSION_ADAPTIVE_MAX_RATIO=0.8
