# Secrets: leave blank here. Use Windows User variables locally and GitHub's
# protected `Test` environment for CI.
OPENROUTER_API_KEY=
HF_TOKEN=

# Non-secret runtime configuration.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/electrohire/noerelay
OPENROUTER_APP_TITLE=NoeRelay
NOERELAY_LIVE_TESTS=0
HF_HOME=.cache/huggingface

# Gateway configuration (non-secret; defaults shown).
NOERELAY_GATEWAY_HOST=127.0.0.1
NOERELAY_GATEWAY_PORT=8080
NOERELAY_OPENROUTER_MODE=stub
NOERELAY_POLICY_PATH=spec/routing-policy.json
NOERELAY_STATE_MACHINE_PATH=spec/verification-state-machine.json
NOERELAY_PORTFOLIO_PATH=examples/candidate-actions.json
NOERELAY_DEFAULT_MAX_COST_USD=0.25
NOERELAY_DEFAULT_MAX_LATENCY_MS=60000
NOERELAY_EXTERNAL_BASE_URL=http://127.0.0.1:8080
