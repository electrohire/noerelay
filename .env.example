# Secrets: leave blank here. Use Windows User variables locally and GitHub's
# protected `test` environment for CI.
OPENROUTER_API_KEY=
HF_TOKEN=

# Non-secret runtime configuration.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/electrohire/noerelay
OPENROUTER_APP_TITLE=NoeRelay
NOERELAY_LIVE_TESTS=0
HF_HOME=.cache/huggingface
